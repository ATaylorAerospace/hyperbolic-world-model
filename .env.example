# Copy to .env and fill in. Never commit .env (it is gitignored).

# Hugging Face access token. Required for gated checkpoints
# (V-JEPA 2 is public; Cosmos 3 Nano requires accepting the OpenMDW terms).
HF_TOKEN=

# Weights & Biases API key. Leave empty to disable logging (offline JSON logs are always written).
WANDB_API_KEY=

# Root directory for datasets (DROID shards, Cosmos 3 generated trajectories). Defaults to ./data
DATA_ROOT=

# Root directory for downloaded encoder weights and trained predictor heads. Defaults to ./checkpoints
CKPT_ROOT=
